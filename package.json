{
  "name": "local-tap-compatible",
  "version": "0.2.1",
  "description": "本地运行的无限画布式节点 AI 工作流：图片/视频生成、倒推提示词等节点均可自定义任意 API",
  "type": "module",
  "license": "MIT",
  "author": "jsxxwhai",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsxxwhai/localtapcompatible.git"
  },
  "bugs": {
    "url": "https://github.com/jsxxwhai/localtapcompatible/issues"
  },
  "keywords": [
    "ai",
    "canvas",
    "workflow",
    "node-based",
    "image-generation",
    "video-generation",
    "prompt-to-image",
    "local"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "desktop:build": "npm run build && node scripts/copy-dist.mjs && dotnet publish desktop/LocalTapCompatible.csproj -c Release -o release",
    "desktop:run": "npm run build && node scripts/copy-dist.mjs && dotnet run --project desktop/LocalTapCompatible.csproj"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
